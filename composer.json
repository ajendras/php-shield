{
    "name": "phpshield/php-shield",
    "description": "Static security scanner and auto-hardener for PHP. Finds and fixes OWASP Top 10 issues using AST analysis.",
    "type": "library",
    "license": "MIT",
    "keywords": ["security", "scanner", "owasp", "static-analysis", "php", "hardener"],
    "authors": [
        {
            "name": "PHP Shield Team"
        }
    ],
    "require": {
        "php": "^8.2",
        "nikic/php-parser": "^4.18",
        "symfony/console": "^6.4",
        "symfony/finder": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "PhpShield\\": "src/"
        }
    },
    "bin": [
        "bin/php-shield"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
